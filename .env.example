# Copy to .env and fill in. Anything left unset uses the default in config.py.

# --- Crawl target ----------------------------------------------------------
# Pre-launch: point at the dummy/staging site. At launch: the real SS site.
START_URL=https://books.toscrape.com/
MAX_PAGES=500
MAX_DEPTH=10
CRAWL_CONCURRENCY=8
CRAWL_DELAY_SECONDS=0.2
REQUEST_TIMEOUT=20
USER_AGENT=internal-linker/1.0 (+SEO internal audit bot)

# --- Data source -----------------------------------------------------------
# TRUE pre-launch (mock traffic). Flip to FALSE at launch to use real Matomo.
USE_MOCK_DATA=true
# Set to the SS launch date (YYYY-MM-DD). If USE_MOCK_DATA is still true after
# this date, the run prints a loud warning. Leave blank pre-launch if unknown.
LAUNCH_DATE=
MATOMO_BASE_URL=
MATOMO_SITE_ID=1
MATOMO_TOKEN=
MATOMO_PERIOD_DAYS=30

# --- Orphan detection ------------------------------------------------------
AT_RISK_MAX_INBOUND=2

# --- Opportunity engine ----------------------------------------------------
BM25_SHORTLIST_SIZE=20
RRF_K=60
PLACEMENT_FLOOR=10
PLACEMENT_CEILING=30
ANCHOR_MATCH_THRESHOLD=80
ORPHAN_BOOST=1.15

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=./chroma_store
CHROMA_COLLECTION=page_embeddings

# --- Decay scoring ---------------------------------------------------------
DECAY_TRAFFIC_WEIGHT=0.6
DECAY_STALENESS_WEIGHT=0.4
EVERGREEN_MIN_WORDS=1500
EVERGREEN_TREND_BAND=10
EVERGREEN_MIN_VISITS=50

# --- LLM (Groq) ------------------------------------------------------------
# Optional. Without a key, briefs use deterministic template actions.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Paths -----------------------------------------------------------------
SNAPSHOT_DIR=./snapshots
REPORT_DIR=./reports

# --- Notifications ---------------------------------------------------------
# Optional Slack incoming webhook for the run summary.
SLACK_WEBHOOK_URL=
