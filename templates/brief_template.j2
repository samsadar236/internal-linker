<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Refresh Brief — {{ brief.title or brief.url }}</title>
</head>
<body>
  <article class="content-factory-brief" data-brief-type="refresh">
    <h1>Content Refresh Brief</h1>

    <section class="meta">
      <p><strong>Page:</strong> <a href="{{ brief.url }}">{{ brief.url }}</a></p>
      <p><strong>Title:</strong> {{ brief.title }}</p>
      <p><strong>Decay score:</strong> {{ "%.2f"|format(brief.decay_score) }}</p>
      <p><strong>Traffic trend:</strong> {{ "%+.0f"|format(brief.traffic_trend) }}%</p>
    </section>

    <section class="why">
      <h2>Why this page was flagged</h2>
      <p>{{ brief.reason }}</p>
    </section>

    <section class="actions">
      <h2>Suggested refresh actions</h2>
      <ul>
        {% for action in brief.suggested_actions %}
        <li>{{ action }}</li>
        {% endfor %}
      </ul>
    </section>

    <footer>
      <p class="handoff-note">
        Generated by the Internal Linking &amp; Content Refresh Recommender.
        All edits are applied through the Content Factory pipeline only (D-S4-9).
        This brief is a recommendation, not a direct edit.
      </p>
    </footer>
  </article>
</body>
</html>
